#!/bin/bash
#!/bin/bash
set -euo pipefail

# -----------------------------------------------------------------------------
# kortex-mode.sh
#   Toggle between a minimal Xorg Kortex session and your regular KDE desktop via SDDM.
#
# Usage:
#   sudo ./kortex-mode.sh kortex   # enable Kortex mode
#   sudo ./kortex-mode.sh desktop  # restore KDE desktop mode
# -----------------------------------------------------------------------------

# Must run as root
if [[ $EUID -ne 0 ]]; then
  echo "This script must be run as root (use sudo)." >&2
  exit 1
fi

# Determine target username (SUDO_USER when called via sudo)
USERNAME="${SUDO_USER:-$(logname)}"
HOME_DIR="/home/$USERNAME"

# File paths
SSDM_DROPIN="/etc/sddm.conf.d/Kortex-mode.conf"
START_SCRIPT="$HOME_DIR/.config/plasma-workspace/env/kortex_start"

function enable_kortex() {
  echo "[*] Enabling Kortex mode for user: $USERNAME"
  cat <<EOF > $SSDM_DROPIN
[Autologin]
Relogin=false
Session=plasma
User=kainatq
EOF

  cat <<EOF >$START_SCRIPT
#!/bin/bash
/bin/kortex
EOF
chmod +x "$START_SCRIPT"
chown "$USERNAME:$USERNAME" "$START_SCRIPT"
  echo "✅ Kortex mode enabled. Reboot to auto-login into your minimal Xorg session."
}

function disable_kortex() {
  echo "[*] Disabling Kortex mode and restoring KDE desktop"
  rm $SSDM_DROPIN
  rm $START_SCRIPT
}

# Entry point
if [[ $# -ne 1 ]]; then
  echo "Usage: $0 [kortex|desktop]"
  exit 1
fi

case "$1" in
  kortex)
    enable_kortex
    ;;
  desktop)
    disable_kortex
    ;;
  *)
    echo "Invalid argument: $1"
    echo "Usage: $0 [kortex|desktop]"
    exit 1
    ;;
  esac
